---
// src/components/Services.astro
export const services = [
  {
    icon: "fas fa-brain",
    title: "Agents that remember the right thing",
    description: "An AI agent is only as good as what it remembers. We give yours memory that surfaces the context that actually matters, follows how your data connects, and can show why it acted — so it answers from the right information, not whatever sounded close.",
    link: "/landing/agent-memory"
  },
  {
    icon: "fas fa-people-group",
    title: "A team of agents that survives production",
    description: "Most agent demos fall apart the moment real work spans more than one step. We design teams that hand off cleanly, stay inside a budget, and keep a human in the loop where it counts — built to run after the pitch is over, not just impress during it.",
    link: "/landing/agentic-team"
  },
  {
    icon: "fas fa-file-lines",
    title: "Answers pulled out of your documents",
    description: "Contracts, PDFs, reports, policies — the answers are in there, just locked behind hundreds of pages no one has time to read. We pull them out and make them as easy to ask about as anything else you own.",
    link: "/services/document-processing-pipeline"
  }
];
---

<section id="services" class="services">
  <div class="container">
    <div class="section-header">
      <h2>Where we come in</h2>
      <p>Three places AI actually earns its keep — set up to work on your real data, and to keep working after the demo.</p>
    </div>
    <div class="services-grid">
      {
        services.map((service) => (
          service.link ? (
            <a href={service.link} class="service-card service-card-link">
              <div class="service-icon">
                <i class={service.icon} />
              </div>
              <h3>{service.title}</h3>
              <p>{service.description}</p>
              <span class="learn-more">Learn more →</span>
            </a>
          ) : (
            <div class="service-card">
              <div class="service-icon">
                <i class={service.icon} />
              </div>
              <h3>{service.title}</h3>
              <p>{service.description}</p>
            </div>
          )
        ))
      }
    </div>
  </div>
</section>
