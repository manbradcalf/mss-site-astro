---
import Layout from "../../layouts/Layout.astro";
import Navigation from "../../components/Navigation.astro";
import Packages from "../../components/Packages.astro";
import ContactForm from "../../components/ContactForm.astro";
import Footer from "../../components/Footer.astro";
---

<Layout
  title="Work With Us - Medcalf Software Solutions"
  description="Scoped engagements with clear deliverables. Discovery Sprints, Build Sprints, and Advisory retainers for AI, graph database, and automation projects."
>
  <Navigation />

  <main class="services-landing">
    <article>
      <div class="container">
        <header class="page-header">
          <h1>How We Work Together</h1>
          <p class="subtitle">
            <em>Scoped engagements with clear deliverables</em>
          </p>
        </header>

        <p class="page-intro">
          Start with a free hour. If there's a fit, we scope a focused sprint
          with a defined deliverable, timeline, and fixed price. No ambiguity.
          No open-ended retainers. You know exactly what you're getting.
        </p>
      </div>

      <Packages showHeader={false} />

      <div class="container page-content">
        <section>
          <h2>Recent Work</h2>
          <ul class="recent-work">
            <li>
              <a href="/blog/honey-i-vibe-coded-the-c-suite"
                >Domain-Specific PDF Extraction with ChatGPT</a
              >
            </li>
            <li>
              <a href="/blog/StatFoundry-Part1"
                >Modeling the NFL as a Knowledge Graph in Neo4j</a
              >
            </li>
            <li>
              <a href="/blog/StatFoundry-Part3"
                >Query Expansion Architecture for Neo4j and React</a
              >
            </li>
          </ul>
        </section>
      </div>
    </article>
  </main>

  <ContactForm />
  <Footer />
</Layout>

<style>
  .services-landing {
    padding-top: 120px;
    padding-bottom: 80px;
    background-color: #fff;
  }

  .services-landing .container {
    max-width: 1100px;
  }

  .page-header {
    margin-bottom: 3rem;
    text-align: center;
    padding-bottom: 2rem;
    border-bottom: 2px solid #f0f0f0;
  }

  .page-header h1 {
    font-size: 3rem;
    color: #333;
    margin: 0 0 1rem 0;
    line-height: 1.2;
  }

  .subtitle {
    font-size: 1.3rem;
    color: #666;
    margin: 0;
  }

  .page-content {
    line-height: 1.7;
    font-size: 1.05rem;
  }

  .page-intro {
    margin-bottom: 2.5rem;
    color: #444;
    text-align: center;
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
  }

  .page-content section h2 {
    font-size: 2rem;
    margin: 3rem 0 1.5rem;
    color: #333;
    border-bottom: 2px solid #23aa57;
    padding-bottom: 0.5rem;
  }

  .recent-work {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0;
  }

  .recent-work li {
    margin-bottom: 0.75rem;
  }

  .recent-work a {
    color: #23aa57;
    text-decoration: none;
    font-size: 1.1rem;
  }

  .recent-work a:hover {
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .services-landing {
      padding-top: 100px;
    }

    .page-header h1 {
      font-size: 2.2rem;
    }

    .subtitle {
      font-size: 1.1rem;
    }

    .page-content {
      font-size: 1rem;
    }
  }
</style>
